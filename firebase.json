{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "toolsmani",
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/imprint{,/**}",
        "destination": "/about/",
        "type": 301
      }
    ],
    "//": "'**' -> /404.html rewrite'i bilincli olarak kaldirildi: bulunamayan yollari 404 icerigiyle ama HTTP 200 koduyla sunuyordu (soft 404). Firebase, out/404.html varsa dogru 404 kodunu kendisi dondurur.",
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
